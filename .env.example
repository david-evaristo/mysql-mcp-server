# ============================================================
#  MySQL MCP Server — Environment Variables
#  Copy to .env and fill in your local values
#  NEVER commit .env to git
# ============================================================

# Connection mode: "teleport" (default) or "direct"
MYSQL_CONNECTION_MODE=teleport

# --- Option A: Teleport Database Access (default) ---
# Start tunnel: tsh db login <db-name> --db-user=<role> && tsh proxy db --tunnel --port=54855
MYSQL_HOST=127.0.0.1
MYSQL_PORT=54855
MYSQL_USER=db-readonly

# --- Option B: Direct Connection (when MYSQL_CONNECTION_MODE=direct) ---
# MYSQL_CONNECTION_MODE=direct
# MYSQL_HOST=mysql.example.com
# MYSQL_PORT=3306
# MYSQL_USER=readonly_user
# MYSQL_PASSWORD=secret_password
# MYSQL_DATABASE=optional_default_db
# MYSQL_SSL_CA=/path/to/ca.pem

# Server behavior
MCP_MAX_ROWS=500
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
PORT=8000
MCP_QUERY_TIMEOUT=30
MCP_CONNECT_TIMEOUT=10
MCP_RATE_LIMIT=60
MCP_POOL_MIN=2
MCP_POOL_MAX=10

