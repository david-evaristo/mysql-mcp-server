# ============================================================
#  MySQL MCP Server — Environment Variables
#  Copy to .env and fill in your local values
#  NEVER commit .env to git
# ============================================================

# MySQL connection via Teleport Database Access tunnel
# Start tunnel with: tsh db login <db-name> --db-user=<role> && tsh proxy db --tunnel --port=54855
MYSQL_HOST=127.0.0.1
MYSQL_PORT=54855
MYSQL_USER=db-readonly

# Server behavior
MCP_MAX_ROWS=500
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
PORT=8000
MCP_QUERY_TIMEOUT=30
MCP_CONNECT_TIMEOUT=10
MCP_RATE_LIMIT=60
MCP_POOL_MIN=1
MCP_POOL_MAX=5
